{
	"name": "WikiExtensions",
	"version": "0.1",
	"author": [
		"WikiTeq"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:WikiExtensions",
	"descriptionmsg": "wikiextensions-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.31.0"
	},
	"MessagesDirs": {
		"WikiExtensions": [
			"i18n"
		]
	},
	"Hooks": {},
	"config": {
		"WikiExtensionsAllowedIP": [
			"127.0.0.1",
			"localhost"
		]
	},
	"ResourceModules": {
		"ext.wikiextensions.special": {
			"styles": [
				"style.less"
			],
			"scripts": [
				"v2/wikiextensions2.js",
				"v2/script.js"
			],
			"templates": {
				"extension.mustache": "templates/extension.mustache",
				"loading.mustache": "templates/loading.mustache"
			},
			"messages": [
				"wikiextensions-special-update",
				"wikiextensions-api-error-unknown",
				"wikiextensions-special-not-git"
			],
			"dependencies": [
				"oojs",
				"oojs-ui",
				"oojs-ui-core",
				"oojs-ui-widgets",
				"oojs-ui.styles.icons-movement",
				"oojs-ui.styles.icons-interactions",
				"oojs-ui.styles.icons-content"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "WikiExtensions/modules"
	},
	"AutoloadClasses": {
		"WikiExtensions\\WikiExtensions": "includes/WikiExtensions.php",
		"WikiExtensions\\SpecialWikiExtensions": "includes/SpecialWikiExtensions.php",
		"WikiExtensions\\WikiExtensionsApi": "includes/WikiExtensionsApi.php"
	},
	"SpecialPages": {
		"WikiExtensions": "WikiExtensions\\SpecialWikiExtensions"
	},
	"APIModules": {
		"wikiextensions": "WikiExtensions\\WikiExtensionsApi"
	},
	"AvailableRights": [
		"wikiextensions_update",
		"wikiextensions_view"
	],
	"GroupPermissions": {
		"sysop": {
			"wikiextensions_update": true,
			"wikiextensions_view": true
		}
	},
	"manifest_version": 1
}
