<table class="wikiextensions-table">
	<thead>
	<tr>
		<th>Extension</th>
		<th>Version</th>
		<th>Branch</th>
		<th>Commits (local - remote)</th>
		<th></th>
	</tr>
	</thead>
	<tbody class="wikiextensions-wrapper">
	</tbody>
</table>
